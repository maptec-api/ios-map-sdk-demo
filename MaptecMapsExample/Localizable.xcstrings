      }
    },
    "gesture_dblclick_delay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-Tap Delay:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击延时:"
          }
        }
