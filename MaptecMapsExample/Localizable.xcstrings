    "gesture_pitch_reset_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Double-tap zoom is disabled on this page. When enabled, double-tapping resets pitch to 0 and no longer zooms. Tilt the map with two fingers first, then test."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明：本页已关闭双击放大。开启后双击地图将复位倾斜角为 0，且不再触发缩放。建议先双指上滑倾斜地图再测试。"
          }
        }
      }
    },
    "gesture_two_finger_tap_enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Two-Finger Tap Zoom Out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用双指点击缩回"
          }
        }
