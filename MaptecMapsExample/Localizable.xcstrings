    "gesture_bearing_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches CameraPosition.bearing (0-360, clockwise from north). Min 0° and max 360° means unlimited; other ranges constrain gesture rotate and programmatic camera updates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 CameraPosition.bearing 一致（0-360，顺时针自北）。最小 0°、最大 360° 表示不限制；其它区间会限制手势旋转和程序化相机设置。"
          }
        }
      }
    },
    "gesture_pitch_reset_enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Double-Tap Pitch Reset"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
