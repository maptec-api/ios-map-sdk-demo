    },
    "gesture_inertial_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: The switch controls whether the gesture module produces inertial scroll (deceleration after release). Duration is the gesture-layer base parameter; 0 also disables inertia. Velocity threshold controls how fast release must be to start inertial scroll. Settings are kept when the switch is off so you can re-enable them later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明：开关控制手势模块是否产生惯性滑动（松手后的减速动画）。时长为手势层基础参数；设为 0 也会关闭惯性。速度阈值控制松手速度达到多少才启动惯性滑动。关闭开关时仍会保存当前配置，便于再次开启。"
          }
        }
      }
    },
