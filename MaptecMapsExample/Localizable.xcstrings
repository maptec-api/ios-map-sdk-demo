        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Sets the zoom transition duration for double-tap and two-finger tap. 0ms means instant. Turning the switch off restores the system default 300ms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明：设置双击、两指单击等操作时的缩放过渡时长。0ms 表示立即完成。关闭开关后将恢复系统默认 300ms。"
          }
        }
      }
    },
