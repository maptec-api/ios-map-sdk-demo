      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: 'gesture-center' zooms around the gesture point (e.g. two-finger midpoint or double-tap point); 'screen-center' zooms around the screen center."
          }
        },
