    "gesture_two_finger_tap_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: When enabled, tapping with two fingers zooms out one level; when disabled, two-finger tap does nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明：开启后，双指同时点击地图将缩小一级；关闭后，双指点击不触发缩小逻辑。"
          }
        }
      }
    },
