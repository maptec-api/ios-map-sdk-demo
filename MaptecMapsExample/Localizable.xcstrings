        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threshold is the minimum movement in pixels before a gesture starts. A larger resistance factor makes the map respond more slowly and stably after triggering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阈值表示触发手势前所需的最小移动像素。阻力系数越大，手势触发后地图响应越缓慢、越稳定。"
          }
        }
      }
    },
    "gesture_inertial_enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Inertial Scroll"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用惯性滑动"
          }
        }
      }
    },
    "gesture_inertial_duration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inertial Scroll Base Duration:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "惯性滑动基础时长:"
          }
        }
      }
    },
    "gesture_inertial_velocity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inertial Scroll Velocity Threshold:"
          }
        },
