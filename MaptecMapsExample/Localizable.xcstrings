      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Controls the zoom multiplier per double-tap. Default is 2.0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明：控制每次双击缩放的倍率，默认值为 2.0。"
          }
        }
      }
    },
    "gesture_zoom_factor_info2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid range is 1.1...5.0; for example, 2.0 usually means one zoom level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效范围为 1.1...5.0；例如 2.0 通常表示放大一级。"
