    "gesture_dblclick_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: When custom detection is enabled, two taps within the delay are treated as a double-tap zoom. Try 300ms-500ms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明：启用自定义检测后，两次点击间隔小于上述延迟时间将判定为双击放大。建议测试 300ms-500ms。"
          }
        }
      }
    },
